RIABITA_DATABASE_URL = "sqlite+pysqlite:///./.data/riabita.sqlite3"
RIABITA_DISTRICTS_PATH = "./data/quartieri.geojson"
RIABITA_DEFAULT_LANGUAGE = "it"
RIABITA_LEADERBOARD_LIMIT = 10